{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "sourceMap": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": [
            "ESNext",
            "DOM"
        ],
        "types": [],
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "ignoreDeprecations": "6.0"
    },
    "include": [
        ".vitepress/**/*.ts",
        ".vitepress/**/*.d.ts",
        ".vitepress/**/*.tsx",
        ".vitepress/**/*.vue",
        ".vitepress/**/*.vue",
        "shims-vue.d.ts",
        "api.config.ts",
        "api.config.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}